+# Rivet Two-Zone layout: if invoked via a Zone D symlink (e.g.
+# filesDir/toolchain/bin/python3 -> nativeLibraryDir/libpython3.so),
+# check relative to the unresolved symlink path in Zone D before
+# falling back to real_executable_dir (Zone E nativeLibraryDir).
+if not executable_dir and executable:
+    _sym_dir = dirname(executable)
+    _sym_parent = dirname(_sym_dir)
+    if any(isfile(joinpath(_sym_parent, p)) for p in STDLIB_LANDMARKS):
+        executable_dir = _sym_dir
+    elif any(isfile(joinpath(joinpath(_sym_parent, 'python'), p)) for p in STDLIB_LANDMARKS):
+        executable_dir = joinpath(joinpath(_sym_parent, 'python'), 'bin')
+
 # If we do not have the executable's directory, we can calculate it.
