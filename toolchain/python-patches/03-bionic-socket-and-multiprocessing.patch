+static void _rivet_sem_path(const char *name, char *buf, size_t buflen) {
+    const char *tmpdir = getenv("TMPDIR");
+    if (!tmpdir || !*tmpdir) {
+        tmpdir = "/data/data/com.kaiser.rivet/files/toolchain/tmp";
+    }
+    while (*name == '/') ++name;
+    snprintf(buf, buflen, "%s/pysem_%s", tmpdir, name);
+}
+
+static sem_t *_rivet_sem_open(const char *name, int oflag, mode_t mode, unsigned int value) {
+    char fname[PATH_MAX];
+    _rivet_sem_path(name, fname, sizeof(fname));
+    int fd = open(fname, oflag | O_RDWR | O_CLOEXEC, mode);
+    if (fd < 0) return SEM_FAILED;
+    if (oflag & O_CREAT) {
+        if (ftruncate(fd, sizeof(sem_t)) < 0) {
+            int err = errno; close(fd); unlink(fname); errno = err; return SEM_FAILED;
+        }
+    }
+    sem_t *sem = (sem_t *)mmap(NULL, sizeof(sem_t), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    int err = errno;
+    close(fd);
+    if (sem == MAP_FAILED) {
+        if (oflag & O_CREAT) unlink(fname);
+        errno = err;
+        return SEM_FAILED;
+    }
+    if (oflag & O_CREAT) {
+        if (sem_init(sem, 1, value) < 0) {
+            err = errno; munmap(sem, sizeof(sem_t)); unlink(fname); errno = err; return SEM_FAILED;
+        }
+    }
+    return sem;
+}
+
+static int _rivet_sem_close(sem_t *sem) {
+    return munmap(sem, sizeof(sem_t));
+}
+
+static int _rivet_sem_unlink(const char *name) {
+    char fname[PATH_MAX];
+    _rivet_sem_path(name, fname, sizeof(fname));
+    return unlink(fname);
+}
