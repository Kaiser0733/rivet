+static int ossl_load_file_or_dir(X509_STORE *store, const char *path)
+{
+  struct stat st;
+  if(!path || !*path)
+    return 0;
+  if(stat(path, &st) != 0)
+    return 0;
+  if(S_ISDIR(st.st_mode)) {
+    DIR *dir = opendir(path);
+    struct dirent *ent;
+    int loaded = 0;
+    if(dir) {
+      while((ent = readdir(dir)) != NULL) {
+        char fullpath[1024];
+        if(ent->d_name[0] == '.')
+          continue;
+        snprintf(fullpath, sizeof(fullpath), "%s/%s", path, ent->d_name);
+        if(X509_STORE_load_file(store, fullpath))
+          loaded++;
+        else
+          ERR_clear_error();
+      }
+      closedir(dir);
+    }
+    if(X509_STORE_load_path(store, path))
+      loaded++;
+    else
+      ERR_clear_error();
+    return loaded > 0 ? 1 : 0;
+  }
+  if(X509_STORE_load_file(store, path))
+    return 1;
+  ERR_clear_error();
+  return 0;
+}
